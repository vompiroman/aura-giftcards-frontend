{
  "name": "aura-giftcards-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tailwindcss -i ./src/canvas.css -o ./public/canvas.css --minify && vite build",
