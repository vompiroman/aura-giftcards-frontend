{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "alias": [
    "www.aura-stream.com",
    "aura-stream.com",
    "aura-stream-deploy.vercel.app"
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "aura-stream-deploy.vercel.app" }],
      "destination": "https://www.aura-stream.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page(netflix-algerie|spotify-family-algerie|crunchyroll-mega-fan-algerie|snapchat-plus-algerie|legal)/index.html", "destination": "/:page", "permanent": true },
    { "source": "/:locale(en|ar)/index.html", "destination": "/:locale", "permanent": true },
    { "source": "/:locale(en|ar)/:page(netflix-algerie|spotify-family-algerie|crunchyroll-mega-fan-algerie|snapchat-plus-algerie)/index.html", "destination": "/:locale/:page", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|ar)",
      "destination": "/:locale/index.html"
    },
    {
      "source": "/:locale(en|ar)/:page(netflix-algerie|spotify-family-algerie|crunchyroll-mega-fan-algerie|snapchat-plus-algerie)",
      "destination": "/:locale/:page/index.html"
    },
    {
      "source": "/snapchat-plus-algerie",
      "destination": "/snapchat-plus-algerie/index.html"
    },
    {
      "source": "/netflix-algerie",
      "destination": "/netflix-algerie/index.html"
    },
    {
      "source": "/spotify-family-algerie",
      "destination": "/spotify-family-algerie/index.html"
    },
    {
      "source": "/crunchyroll-mega-fan-algerie",
      "destination": "/crunchyroll-mega-fan-algerie/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aura-giftcards-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://aura-giftcards-api.onrender.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
